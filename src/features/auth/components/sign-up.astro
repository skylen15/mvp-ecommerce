---
import { Button } from "@/components/starwind/button";
import {
	Card,
	CardContent,
	CardDescription,
	CardFooter,
	CardHeader,
	CardTitle,
} from "@/components/starwind/card";
import { Label } from "@/components/starwind/label";
import { Input } from "@/components/starwind/input";
import { Spinner } from "@/components/starwind/spinner";
import Layout from "@/layouts/base-layout.astro";

console.log("sign-up");
if (Astro.locals.user?.id) {
	return Astro.redirect("/");
}
---

<Layout>
	<main class="flex-1 p-4 flex items-center justify-center">
		<Card>
			<CardHeader>
				<CardTitle>Register your account</CardTitle>
				<CardDescription>
					Enter your email below to register your account
				</CardDescription>
			</CardHeader>
			<form id="register-form">
				<CardContent>
					<div class="flex flex-col gap-6">
						<div class="grid gap-2">
							<Label for="name">Name</Label>
							<Input
								id="name"
								name="name"
								type="text"
								placeholder="John Doe"
								required
							/>
						</div>
						<div class="grid gap-2">
							<Label for="email">Email</Label>
							<Input
								id="email"
								type="email"
								name="email"
								placeholder="m@example.com"
								required
							/>
						</div>
						<div class="grid gap-2">
							<div class="flex items-center">
								<Label for="password">Password</Label>
							</div>
							<Input
								id="password"
								type="password"
								name="password"
								placeholder="********"
								required
							/>
						</div>
					</div>
				</CardContent>
				<CardFooter class="items-center flex justify-between p-8 pt-0">
					<Button variant="outline" href="/auth/sign-in"
						>Sign In</Button
					>
					<Button type="submit">
						<Spinner class="spinner mr-2 size-4 hidden" />
						Create Account
					</Button>
				</CardFooter>
			</form>
		</Card>
	</main>
</Layout>

<script>
	import { authClient } from "@/lib/auth-client";

	const formSelector = document.querySelector(
		"#register-form",
	) as HTMLFormElement;

	const submitBtn = document.querySelector(
		"button[type='submit']",
	) as HTMLButtonElement;

	const spinner = document.querySelector(".spinner");

	formSelector.addEventListener("submit", async (e) => {
		e.preventDefault();
		const formData = new FormData(e.target as HTMLFormElement);
		await authClient.signUp.email({
			name: formData.get("name") as string,
			email: formData.get("email") as string,
			password: formData.get("password") as string,
			fetchOptions: {
				onRequest: () => {
					if (spinner) {
						spinner.classList.remove("hidden");
					}
					submitBtn.disabled = true;
				},
				onSuccess: () => {
					if (spinner) {
						spinner.classList.add("hidden");
					}
					submitBtn.disabled = true;
					window.location.pathname = "/";
				},
				onError: (ctx) => {
					if (spinner) {
						spinner.classList.add("hidden");
					}
					submitBtn.disabled = true;
					console.error(ctx.error.message);
				},
			},
		});
	});
</script>

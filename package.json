{
	"name": "mvp-ecommerce",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"kysely:codegen": "kysely-codegen --dialect postgres --runtime-enums=screaming-snake-case --out-file ./src/lib/server/db/db.d.ts",
		"auth:migrate": "pnpm dlx @better-auth/cli migrate --config ./src/lib/server/auth.ts",
		"auth:gen": "pnpm dlx @better-auth/cli generate --config ./src/lib/server/auth.ts",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage"
	},
	"dependencies": {
		"@astrojs/node": "^9.5.1",
		"@effect/platform": "^0.94.0",
		"@effect/platform-node": "^0.104.0",
		"@tabler/icons": "^3.36.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.1.18",
		"astro": "^5.16.6",
		"better-auth": "^1.4.9",
		"effect": "^3.19.13",
		"embla-carousel": "^8.6.0",
		"kysely": "^0.28.9",
		"pg": "^8.16.3",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.18"
	},
	"devDependencies": {
		"@effect/language-service": "^0.62.5",
		"@types/pg": "^8.16.0",
		"@vitest/coverage-v8": "^2.1.8",
		"@vitest/ui": "^2.1.8",
		"happy-dom": "^15.11.7",
		"kysely-codegen": "^0.19.0",
		"tw-animate-css": "^1.4.0",
		"vitest": "^2.1.8"
	}
}
